// Prisma Schema Multi-tenant (PostgreSQL - Supabase / Producción / Staging)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS CLÍNICOS & OPERACIONALES
// ==========================================

enum Sexo {
  MASCULINO
  FEMENINO
}

enum TipoResultado {
  NUMERICO
  TEXTO
  POSITIVO_NEGATIVO
}

enum EstadoOrden {
  PENDIENTE
  EN_PROCESO
  VALIDADO
  ENTREGADO
}

enum EstadoPago {
  PENDIENTE
  PARCIAL
  PAGADO
}

enum MetodoPago {
  EFECTIVO_USD
  EFECTIVO_BS
  PAGO_MOVIL
  PUNTO_DE_VENTA
  ZELLE
  BINANCE_USDT
  TRANSFERENCIA_BS
}

enum Moneda {
  USD
  VES
}

enum Rol {
  ADMINISTRADOR
  BIOANALISTA
  RECEPCIONISTA
}

enum LAB_AREA {
  HEMATOLOGIA
  QUIMICA_SANGUINEA
  COAGULACION
  UROANALISIS
  COPROANALISIS
  INMUNOLOGIA_SEROLOGIA
  HORMONAS
}

// ==========================================
// TENANT (EMPRESA / LABORATORIO MATRIZ)
// ==========================================

model Tenant {
  id        String   @id @default(uuid())
  nombre    String
  rif       String
  slug      String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relaciones de aislamiento Multi-tenant
  branches  Branch[]
  users     User[]
  patients  Patient[]
  tests     Test[]
  orders    Order[]
  payments  Payment[]
  settings  LabSetting?

  @@map("tenants")
}

// ==========================================
// SUCURSAL (SEDE FÍSICA)
// ==========================================

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  nombre    String   // Ej: "Sede Principal", "Sede Norte"
  direccion String
  telefono  String
  createdAt DateTime @default(now())

  users     User[]
  orders    Order[]
  payments  Payment[]

  @@index([tenantId])
  @@map("branches")
}

// ==========================================
// MODELOS DEL DOMINIO
// ==========================================

model User {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  email          String   @unique
  passwordHash   String
  nombreCompleto String
  rol            Rol
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
  @@map("users")
}

model LabSetting {
  id                 String   @id @default(uuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  nombreLaboratorio  String   @default("Laboratorio Central C.A.")
  rif                String   @default("J-40123456-7")
  direccion          String   @default("Av. Francisco de Miranda, Edif. Centro Médico, PB - Caracas")
  telefono           String   @default("+58 (212) 555-0199")
  email              String?  @default("contacto@labclinic.com.ve")
  tasaBcvActual      Decimal  @default(36.50) @db.Decimal(12, 4)
  logoUrl            String?
  mensajePiePagina   String?  @default("Resultados confidenciales con fines diagnósticos. Protegidos por la ley del ejercicio del Bioanálisis.")
  updatedAt          DateTime @updatedAt

  @@index([tenantId])
  @@map("lab_settings")
}

model Patient {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  cedula          String
  nombreCompleto  String
  fechaNacimiento DateTime
  sexo            Sexo
  telefono        String
  email           String?
  direccion       String?
  
  orders          Order[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, cedula])
  @@index([tenantId])
  @@index([cedula])
  @@index([nombreCompleto])
  @@map("patients")
}

model Test {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  codigo             String
  nombre             String
  precioUsd          Decimal         @db.Decimal(10, 2)
  tiempoEntregaHoras Int             @default(24)
  categoria          String
  area               LAB_AREA        @default(HEMATOLOGIA)
  tipoMuestra        String          @default("Suero") // "Suero" | "Plasma Citratado" | "Sangre Total EDTA" | "Orina"
  activo             Boolean         @default(true)

  parameters         TestParameter[]
  orderItems         OrderItem[]

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([categoria])
  @@index([area])
  @@index([activo])
  @@map("tests")
}

model TestParameter {
  id                 String         @id @default(uuid())
  testId             String
  test               Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  
  nombre             String
  unidadMedida       String?
  tipoResultado      TipoResultado  @default(NUMERICO)
  requiereControl    Boolean        @default(false)      // Para pruebas de coagulación TP/TPT (Paciente vs Control)
  
  rangoMinHombre     Float?
  rangoMaxHombre     Float?
  rangoMinMujer      Float?
  rangoMaxMujer      Float?
  rangoMinNino       Float?
  rangoMaxNino       Float?
  
  valorPorDefecto    String?
  ordenVisualizacion Int            @default(0)

  results            OrderResult[]

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([testId])
  @@map("test_parameters")
}

model Order {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)

  codigoOrden     String
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  
  fechaCreacion   DateTime      @default(now())
  estado          EstadoOrden   @default(PENDIENTE)
  medicoTratante  String?
  observaciones   String?

  totalUsd        Decimal       @db.Decimal(12, 2)
  tasaBcv         Decimal       @db.Decimal(12, 4)
  totalBs         Decimal       @db.Decimal(16, 2)
  estadoPago      EstadoPago    @default(PENDIENTE)

  items           OrderItem[]
  results         OrderResult[]
  payments        Payment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([tenantId, codigoOrden])
  @@index([tenantId])
  @@index([branchId])
  @@index([patientId])
  @@index([estado])
  @@index([estadoPago])
  @@index([fechaCreacion])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  testId            String
  test              Test     @relation(fields: [testId], references: [id], onDelete: Restrict)
  
  precioUnitarioUsd Decimal  @db.Decimal(10, 2)

  createdAt         DateTime @default(now())

  @@index([orderId])
  @@index([testId])
  @@map("order_items")
}

model OrderResult {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  testParameterId String
  testParameter   TestParameter @relation(fields: [testParameterId], references: [id], onDelete: Restrict)
  
  valor           String
  valorControl    String?       // Tiempo o valor del Control/Testigo para pruebas de coagulación
  fueraDeRango    Boolean       @default(false)
  observaciones   String?
  
  validado        Boolean       @default(false)
  validadoPor     String?
  fechaValidacion DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([orderId, testParameterId])
  @@index([orderId])
  @@index([testParameterId])
  @@map("order_results")
}

model Payment {
  id                  String     @id @default(uuid())
  tenantId            String
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  orderId             String
  order               Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  metodoPago          MetodoPago
  monedaOriginal      Moneda
  montoOriginal       Decimal    @db.Decimal(14, 2)
  tasaCambio          Decimal    @db.Decimal(12, 4)
  montoEquivalenteUsd Decimal    @db.Decimal(12, 2)
  
  referencia          String?
  notas               String?

  createdAt           DateTime   @default(now())

  @@index([tenantId])
  @@index([branchId])
  @@index([orderId])
  @@index([metodoPago])
  @@index([createdAt])
  @@map("payments")
}
