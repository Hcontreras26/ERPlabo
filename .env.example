# ==============================================================================
# Supabase PostgreSQL Database URLs
# ==============================================================================

# Connection Pooling (Transaction Mode - Recomendado para Vercel Serverless / Next.js)
DATABASE_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-[TU-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Session Mode / Migraciones de Prisma / prisma db push)
DIRECT_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-[TU-REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# Aplicación
# ==============================================================================
NEXT_PUBLIC_APP_NAME="ERP LIS Venezuela"
JWT_SECRET="super-secret-key-change-in-production-lab-venezuela"
